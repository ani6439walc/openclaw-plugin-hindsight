{
  "name": "@ani6439walc/openclaw-plugin-hindsight",
  "displayName": "Hindsight",
  "description": "Hindsight memory plugin for OpenClaw - biomimetic long-term memory with fact extraction",
  "version": "2026.10.2",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-hindsight#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ani6439walc/openclaw-plugin-hindsight.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-hindsight/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "hindsight",
    "long-term-memory"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.9",
      "minGatewayVersion": "2026.9.9"
    },
    "build": {
      "openclawVersion": "2026.10.2",
      "pluginSdkVersion": "2026.10.2"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc",
    "prepack": "node scripts/pack-manifest.mjs strip",
    "postpack": "node scripts/pack-manifest.mjs restore",
    "backfill:help": "node dist/backfill.js --help"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@vectorize-io/hindsight-agent-sdk": "^0.1.1",
    "@vectorize-io/hindsight-all": "^0.10.3",
    "@vectorize-io/hindsight-client": "^0.10.3"
  },
  "peerDependencies": {
    "openclaw": "2026.10.2"
  },
  "devDependencies": {
    "@openclaw/proxyline": "0.4.0",
    "@types/node": "^26.0.0",
    "@vitest/ui": "5.0.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "rollup": "^4.64.5",
    "picomatch": ">=2.3.2 <3.0.0 || >=4.0.7",
    "vite": ">=8.3.4",
    "postcss": ">=8.5.29 <9.0.0"
  }
}
